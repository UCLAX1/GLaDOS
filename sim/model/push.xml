<mujoco model="glados_arm">

  <compiler angle="radian"/>
   <!-- Draw joint axes/pivots in the viewer -->
  <visual>
    <!-- <scale jointlength="0.9" jointwidth="0.9"/> -->
    <scale jointlength="0.005" jointwidth="0.0003"/>
    <headlight ambient="0.4 0.4 0.4"/>
  </visual>

  <!-- Physics settings -->
  <option timestep="0.002" gravity="0 0 -9.81"/>

 
     
      

  <default>
    <!-- closed-loop parts overlap by design; collision fights the equality solver -->
    <geom contype="0" conaffinity="0"/>
    <default class="horn">
      <geom type="box" size="0.001125 0.001125 0.0075" pos="0 0 0.0075"/>
    </default>
  </default>

  <!-- materials like unity -->
  <asset>
    <material name = "body1" rgba = "1 0 0 1" shininess = "0.4" specular = "0.3"/>
    <material name = "body2" rgba = "0 1 0 1" shininess = "0.4" specular = "0.3"/>
    <material name = "body3" rgba = "0 0 1 1" shininess = "0.4" specular = "0.3"/>
    <material name = "body" rgba = "0.1 0.1 0.1 1" shininess = "0.2" specular = "0.2"/>
    <material name = "horn" rgba = "1 0.5 0 1" shininess = "0.4" specular = "0.3"/>
  </asset>

  <worldbody>
    <!-- all the components right here -->
    <!-- red is body1, green is body2, blue is body3, orange is horn -->
    <body name="horn1" pos="-0.02165 -0.0125 0">
      <joint name="horn1_joint" type="hinge" axis="0.5 -0.866 0" pos="0 0 0" limited="true" range="-1.57 1.57" damping="15" armature="0.2"/>
      <geom class="horn" material="body1"/>
      <!-- rod: dangling branch, closed onto the plate via the equality/connect block below -->
      <body name="rod1" pos="0 0 0.015">
        <joint name="rod1_joint" type="ball" pos="0 0 0" damping="0.01" armature="0.001"/>
        <geom name="rod1_geom" type="cylinder" fromto="0 0 0 0 0 0.08" size="0.0015" material="horn"/>
        <site name="rod1_tip" pos="0 0 0.08" size="0.003"/>
      </body>
    </body>
    <body name="horn2" pos="0.02165 -0.0125 0">
      <joint name="horn2_joint" type="hinge" axis="0.5 0.866 0" pos="0 0 0" limited="true" range="-1.57 1.57" damping="15" armature="0.2"/>
      <geom class="horn" material="body2"/>
      <body name="rod2" pos="0 0 0.015">
        <joint name="rod2_joint" type="ball" pos="0 0 0" damping="0.01" armature="0.001"/>
        <geom name="rod2_geom" type="cylinder" fromto="0 0 0 0 0 0.08" size="0.0015" material="horn"/>
        <site name="rod2_tip" pos="0 0 0.08" size="0.003"/>
      </body>
    </body>
    <body name="horn3" pos="0 0.025 0">
      <joint name="horn3_joint" type="hinge" axis="-1 0 0" pos="0 0 0" limited="true" range="-1.57 1.57" damping="15" armature="0.2"/>
      <geom class="horn" material="body3"/>
      <body name="rod3" pos="0 0 0.015">
        <joint name="rod3_joint" type="ball" pos="0 0 0" damping="0.01" armature="0.001"/>
        <geom name="rod3_geom" type="cylinder" fromto="0 0 0 0 0 0.08" size="0.0015" material="horn"/>
        <site name="rod3_tip" pos="0 0 0.08" size="0.003"/>
      </body>
    </body>

    <!-- fixed central post: world geom, not a body -->
    <geom name="post" type="cylinder" fromto="0 0 0 0 0 0.095" size="0.002" material="body"/>

    <!-- head plate: pinned at center via ball joint, tilts/leans freely, cannot translate -->
    <body name="plate" pos="0 0 0.095">
      <joint name="plate_joint" type="ball" pos="0 0 0" damping="0.01" armature="0.001"/>
      <geom name="plate_geom" type="box" size="0.02 0.02 0.003" material="body" mass="0.05"/>
      <!-- asymmetric marker so yaw is visible in the viewer -->
      <geom name="plate_marker" type="box" size="0.004 0.004 0.004" pos="0.025 0 0.004" material="horn" density="0"/>
      <site name="anchor1" pos="-0.02165 -0.0125 0" size="0.002"/>
      <site name="anchor2" pos="0.02165 -0.0125 0" size="0.002"/>
      <site name="anchor3" pos="0 0.025 0" size="0.002"/>
    </body>
  </worldbody>

<!-- Actuator -->
 <actuator>
    <position name="horn1" joint="horn1_joint" kp="200" ctrlrange="-1.57 1.57"/>
    <position name="horn2" joint="horn2_joint" kp="200" ctrlrange="-1.57 1.57"/>
    <position name="horn3" joint="horn3_joint" kp="200" ctrlrange="-1.57 1.57"/>
</actuator>

  <!-- close the loop: each dangling rod tip is pinned to its plate anchor -->
  <equality>
    <connect site1="rod1_tip" site2="anchor1" solref="0.002 1"/>
    <connect site1="rod2_tip" site2="anchor2" solref="0.002 1"/>
    <connect site1="rod3_tip" site2="anchor3" solref="0.002 1"/>
  </equality>

</mujoco>

  <!-- PUSH-ROD MECHANISM PARAMETERS -- swap values here. -->
       <!-- MJCF has no variables/macros, so these are also baked into -->
       <!-- the positions/sizes below; keep them in sync with this table. -->
        <!-- R (center -> servo pivot)      = 0.025  confirmed (d=0.05 m circle) -->
         <!-- rod length L                   = 0.08   confirmed (ball-to-ball) -->
         <!-- horn length                    = 0.015  PLACEHOLDER, unmeasured -->
         <!-- plate height = horn + L        = 0.095  derived -->
         <!-- servo spacing                  = 120 deg assumed -->