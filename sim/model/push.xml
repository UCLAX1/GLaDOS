<mujoco model="glados_push">

  <compiler angle="radian"/>



  <!-- Draw joint axes/pivots in the viewer -->
  <visual>
    <scale jointlength="0.005" jointwidth="0.0003"/>
    <headlight ambient="0.4 0.4 0.4"/>
  </visual>

  <!-- Physics settings -->
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <!-- closed-loop parts overlap by design; collision fights the equality solver -->
    <geom contype="0" conaffinity="0"/>
  </default>

  <!-- materials like unity -->
  <asset>
    <material name="body1" rgba="1 0 0 1" shininess="0.4" specular="0.3"/>
    <material name="body2" rgba="0 1 0 1" shininess="0.4" specular="0.3"/>
    <material name="body3" rgba="0 0 1 1" shininess="0.4" specular="0.3"/>
    <material name="body"  rgba="0.1 0.1 0.1 1" shininess="0.2" specular="0.2"/>
    <material name="horn"  rgba="1 0.5 0 1" shininess="0.4" specular="0.3"/>
    <material name="eye"   rgba="1.0 0.78 0.0 1" shininess="1.0" specular="0.8" emission="0.4"/>
    <material name="gray"  rgba="0.55 0.55 0.55 1" shininess="0.3" specular="0.2"/>
  </asset>

  <worldbody>
    <light name="top" pos="0 0 2" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>

    <!--
      head_support: stand-in for the head_mount site frame on
      lower_arm in glados.xml (see OPEN QUESTIONS above). Everything
      below is local to this body.
    -->
    <body name="head_support" pos="0 0 0">

      <!-- Shared mounting plate: all 3 linear actuators sit on this one plate
           instead of separate per-station reference plates. Radius covers the
           r_s=0.055 mount circle plus actuator-housing clearance. -->
      <geom name="linact_base_plate" type="cylinder" pos="0 0 0.0015" size="0.075 0.0015" material="gray"/>

      <!--
        Station 0, a0=210 deg: linear actuator (slide) with a
        hinge+horn on its tip, no rod — the horn itself reaches the
        plate. Horn travel +/-60 deg about the mounted center (which
        is now defined as "pointing straight at the plate", see
        OPEN QUESTIONS). No slide range set.
      -->
      <body name="linact0" pos="-0.04763 -0.0275 0">
        <joint name="linact0_joint" type="slide" axis="0 0 -1" pos="0 0 0" damping="5" armature="0.05"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.03" size="0.004" material="body1"/>
        <site name="linact0_tip" pos="0 0 -0.03" size="0.003" rgba="1 1 0 1"/>
        <!-- moving plate: travel indicator, tracks the slide only (doesn't rotate with horn0) -->
        <geom name="linact0_slide_plate" type="box" pos="0 0 -0.0285" size="0.006 0.006 0.0015" material="body1"/>
        <body name="horn0" pos="0 0 -0.03">
          <joint name="horn0_joint" type="hinge" axis="0.5 -0.86603 0" pos="0 0 0"
                 limited="true" range="-1.0472 1.0472" damping="15" armature="0.2"/>
          <!-- No rod: horn geom itself extended to 0.06083m and re-pointed so its tip lands
               exactly on plate_0 at qpos=0. Vector computed from this station's actual mount
               depth and plate_0's actual position (off-hinge-plane error ~0, confirmed
               numerically) — not guessed. -->
          <geom type="capsule" fromto="0 0 0 0.00866 0.005 -0.06" size="0.005" material="body1"/>
          <site name="horn0_tip" pos="0.00866 0.005 -0.06" size="0.003"/>
        </body>
      </body>

      <!--
        Station 1, a1=330 deg: same as station 0, mirrored.
      -->
      <body name="linact1" pos="0.04763 -0.0275 0">
        <joint name="linact1_joint" type="slide" axis="0 0 -1" pos="0 0 0" damping="5" armature="0.05"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.03" size="0.004" material="body2"/>
        <site name="linact1_tip" pos="0 0 -0.03" size="0.003" rgba="1 1 0 1"/>
        <!-- moving plate: travel indicator, tracks the slide only (doesn't rotate with horn1) -->
        <geom name="linact1_slide_plate" type="box" pos="0 0 -0.0285" size="0.006 0.006 0.0015" material="body2"/>
        <body name="horn1" pos="0 0 -0.03">
          <joint name="horn1_joint" type="hinge" axis="0.5 0.86603 0" pos="0 0 0"
                 limited="true" range="-1.0472 1.0472" damping="15" armature="0.2"/>
          <!-- No rod: horn geom extended to 0.06083m and re-pointed so its tip lands exactly
               on plate_1 at qpos=0, mirrored from station 0. -->
          <geom type="capsule" fromto="0 0 0 -0.00866 0.005 -0.06" size="0.005" material="body2"/>
          <site name="horn1_tip" pos="-0.00866 0.005 -0.06" size="0.003"/>
        </body>
      </body>

      <!--
        Station 2, a2=90 deg: linear actuator (slide) with the rod
        bolted straight on — fixed angle, no horn, no hinge.
      -->
      <body name="linact2" pos="0 0.055 0">
        <joint name="linact2_joint" type="slide" axis="0 0 -1" pos="0 0 0" damping="5" armature="0.05"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.03" size="0.004" material="body3"/>
        <site name="linact2_tip" pos="0 0 -0.03" size="0.003" rgba="1 1 0 1"/>
        <!-- moving plate: travel indicator, station 2 has no horn to match length against -->
        <geom name="linact2_slide_plate" type="box" pos="0 0 -0.0285" size="0.006 0.006 0.0015" material="body3"/>
        <!-- fixed station: ball socket -> flat plate/rectangle (no horn) -> face via plate_2 -->
        <body name="plate2" pos="0 0 -0.03">
          <!-- damping/armature bumped from a 0.01/0.001 placeholder — near-zero
               there let the plate flop under the head's weight ("folding like
               a string"). Still coarse, retune once real mass numbers are in. -->
          <joint name="plate2_joint" type="ball" pos="0 0 0" damping="10" armature="0.1"/>
          <geom name="plate2_geom" type="box" pos="0 -0.0175 -0.045" zaxis="0 -0.035 -0.09"
                size="0.01 0.003 0.048285" material="horn"/>
          <site name="plate2_tip" pos="0 -0.035 -0.09" size="0.003"/>
        </body>
      </body>

      <!-- Plate: central pivot, ball joint at its own origin -->
      <body name="neck_platform" pos="0 0 -0.09">
        <joint name="neck_platform_joint" type="ball" pos="0 0 0" damping="20" armature="0.2"/>
        <geom name="neck_platform_geom" type="cylinder" size="0.05 0.003" material="body"/>
        <site name="plate_0" pos="-0.03897 -0.0225 0" size="0.002"/>
        <site name="plate_1" pos="0.03897 -0.0225 0" size="0.002"/>
        <site name="plate_2" pos="0 0.045 0" size="0.002"/>

        <!-- Head/eye assembly — L3=0.18m total from neck_platform to eye tip -->
        <!-- neck_platform→head: 0.10m  +  head→eye: 0.07m  +  eye half-height: 0.01m = 0.18m -->
        <!-- TODO: tune head pos z once rod length is measured from real hardware -->
        <body name="head" pos="0 0 -0.10">
          <geom type="cylinder" size="0.07 0.04" euler="1.5708 0 0" mass="3.0"/>

          <!-- IK reference point — tip of eye -->
          <site name="end_effector" pos="0 0 -0.08" size="0.0005" rgba="1 0 0 1"/>

          <!-- Eye — extends/retracts from head -->
          <body name="eye" pos="0 0 -0.07">
            <joint name="eye_joint" type="slide" axis="0 0 -1" pos="0 0 0" limited="true" range="-0.002 0.002"/>
            <geom type="cylinder" size="0.015 0.010" material="eye"/>
          </body>

        </body>
      </body>
    </body>

  </worldbody>

  <!-- Actuator -->
  <actuator>
    <position name="horn0_actuator" joint="horn0_joint" kp="200" ctrlrange="-1.0472 1.0472"/>
    <position name="horn1_actuator" joint="horn1_joint" kp="200" ctrlrange="-1.0472 1.0472"/>
    <!-- TODO: ctrlrange is a placeholder — no stroke spec confirmed yet, tune once mechanical measures it -->
    <!-- kp/kv much higher than horn's (200): a real leadscrew actuator is non-backdrivable,
         it should hold its commanded position against the loop-closure reaction force from
         the horn/rod instead of getting dragged by it. neck_platform has no actuator of its
         own (only damping), so it's the compliant member that should absorb that motion. -->
    <position name="linact0_actuator" joint="linact0_joint" kp="5000" kv="32" ctrlrange="-0.01 0.01"/>
    <position name="linact1_actuator" joint="linact1_joint" kp="5000" kv="32" ctrlrange="-0.01 0.01"/>
    <position name="linact2_actuator" joint="linact2_joint" kp="5000" kv="32" ctrlrange="-0.01 0.01"/>
    <!-- the head -->
    
  </actuator>

  <!-- explicit horn<->actuator excludes (requested); geoms are already
       globally contype=0/conaffinity=0 above so no contact exists either
       way — see note below on what's actually moving the actuator -->
  <contact>
    <exclude body1="linact0" body2="horn0"/>
    <exclude body1="linact1" body2="horn1"/>
    <exclude body1="linact2" body2="plate2"/>
  </contact>

  <!-- close the loop: each horn/plate tip is pinned to its plate anchor -->
  <equality>
    <connect site1="horn0_tip" site2="plate_0" solref="0.002 1"/>
    <connect site1="horn1_tip" site2="plate_1" solref="0.002 1"/>
    <connect site1="plate2_tip" site2="plate_2" solref="0.002 1"/>
  </equality>

</mujoco>
