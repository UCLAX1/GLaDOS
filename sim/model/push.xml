<!-- 3-RSS face: 3 servos -> rod1 (horn) -> rod2 -> face, face rides a center post (lift + tilt). -->
<mujoco model="glados_push">
  <compiler angle="radian"/>
  <option timestep="0.002"/>
  <default>
    <!-- parts overlap by design; collisions would fight the loop constraints -->
    <geom contype="0" conaffinity="0"/>
  </default>
  <visual><headlight ambient="0.4 0.4 0.4"/></visual>

  <asset>
    <mesh name="linact_plate" file="plate.obj"/>
    <mesh name="face_plate" file="face.obj"/>
    <material name="servo" rgba="0.1 0.1 0.1 1" shininess="0.2" specular="0.2"/>
    <material name="horn" rgba="0.1 0.3 0.9 1"/>
    <material name="rod" rgba="0.75 0.75 0.75 1" shininess="0.6" specular="0.5"/>
    <material name="gray" rgba="0.55 0.55 0.55 1" shininess="0.3" specular="0.2"/>
  </asset>

  <worldbody>
    <light name="top" pos="0 0 2" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="linact_base_plate" type="mesh" mesh="linact_plate" material="gray"/>

    <!-- BEGIN gen_linkage -->
    <!-- Center post: without it 3 RSS legs leave the face with 3 free DOF (it would drift sideways/spin).
         Visual only; the face's lift+tilt joints below are what it enforces. -->
    <geom name="center_post" type="capsule" fromto="0 0 0.0015 0 0 0.1" size="0.003" material="rod"/>

    <!-- GLaDOS face, 100mm above base. -->
    <body name="face" pos="0 0 0.1">
      <!-- center guide: face can lift (slide) and tilt (2 hinges), no yaw = 3 DOF for 3 servos -->
      <joint name="face_lift" type="slide" axis="0 0 1" damping="0.05"/>
      <joint name="face_roll" type="hinge" axis="1 0 0" damping="0.01"/>
      <joint name="face_pitch" type="hinge" axis="0 1 0" damping="0.01"/>
      <geom name="face_plate" type="mesh" mesh="face_plate" material="gray"/>
      <site name="face_0" pos="0 0.064 0" size="0.003"/>
      <site name="face_1" pos="-0.05543 -0.032 0" size="0.003"/>
      <site name="face_2" pos="0.05543 -0.032 0" size="0.003"/>
    </body>

    <!-- Servos: sit on the base plate top, flush against each flat end. -->
    <geom name="servo0" type="box" size="0.02 0.01 0.018" pos="0 0.07 0.0195" euler="0 0 0" material="servo"/>
    <geom name="servo1" type="box" size="0.02 0.01 0.018" pos="-0.06062 -0.035 0.0195" euler="0 0 2.0944" material="servo"/>
    <geom name="servo2" type="box" size="0.02 0.01 0.018" pos="0.06062 -0.035 0.0195" euler="0 0 4.18879" material="servo"/>

    <!-- station 0 (90 deg): servo shaft (normal to servo face) -> rod1 (horn, sweeps parallel to face) -> rod2 -> face flat-end center -->
    <body name="rod1_0" pos="0 0.083 0.03">
      <joint name="servo0_joint" type="hinge" axis="0 1 0" range="0 2.0944" damping="0.05" armature="0.001"/>
      <geom type="capsule" fromto="0 0 0 -0.02165 0 0.0125" size="0.003" material="horn"/>
      <body name="rod2_0" pos="-0.02165 0 0.0125">
        <joint name="rod2_0_ball" type="ball" damping="0.001"/>
        <geom type="capsule" fromto="0 0 0 0.02165 -0.019 0.0575" size="0.002" material="rod"/>
        <site name="rod2_0_tip" pos="0.02165 -0.019 0.0575" size="0.003"/>
      </body>
    </body>
    <!-- station 1 (210 deg): servo shaft (normal to servo face) -> rod1 (horn, sweeps parallel to face) -> rod2 -> face flat-end center -->
    <body name="rod1_1" pos="-0.07188 -0.0415 0.03">
      <joint name="servo1_joint" type="hinge" axis="-0.86603 -0.5 0" range="0 2.0944" damping="0.05" armature="0.001"/>
      <geom type="capsule" fromto="0 0 0 0.01083 -0.01875 0.0125" size="0.003" material="horn"/>
      <body name="rod2_1" pos="0.01083 -0.01875 0.0125">
        <joint name="rod2_1_ball" type="ball" damping="0.001"/>
        <geom type="capsule" fromto="0 0 0 0.00563 0.02825 0.0575" size="0.002" material="rod"/>
        <site name="rod2_1_tip" pos="0.00563 0.02825 0.0575" size="0.003"/>
      </body>
    </body>
    <!-- station 2 (330 deg): servo shaft (normal to servo face) -> rod1 (horn, sweeps parallel to face) -> rod2 -> face flat-end center -->
    <body name="rod1_2" pos="0.07188 -0.0415 0.03">
      <joint name="servo2_joint" type="hinge" axis="0.86603 -0.5 0" range="0 2.0944" damping="0.05" armature="0.001"/>
      <geom type="capsule" fromto="0 0 0 0.01083 0.01875 0.0125" size="0.003" material="horn"/>
      <body name="rod2_2" pos="0.01083 0.01875 0.0125">
        <joint name="rod2_2_ball" type="ball" damping="0.001"/>
        <geom type="capsule" fromto="0 0 0 -0.02728 -0.00925 0.0575" size="0.002" material="rod"/>
        <site name="rod2_2_tip" pos="-0.02728 -0.00925 0.0575" size="0.003"/>
      </body>
    </body>
    <!-- END gen_linkage -->
  </worldbody>

  <actuator>
    <!-- BEGIN gen_linkage actuators -->
    <position name="servo0" joint="servo0_joint" kp="2" ctrlrange="0 2.0944"/>
    <position name="servo1" joint="servo1_joint" kp="2" ctrlrange="0 2.0944"/>
    <position name="servo2" joint="servo2_joint" kp="2" ctrlrange="0 2.0944"/>
    <!-- END gen_linkage actuators -->
  </actuator>

  <!-- close each leg: rod2 tip pinned to the face's flat-end center -->
  <equality>
    <connect solref="0.002 1" site1="rod2_0_tip" site2="face_0"/>
    <connect solref="0.002 1" site1="rod2_1_tip" site2="face_1"/>
    <connect solref="0.002 1" site1="rod2_2_tip" site2="face_2"/>
  </equality>
</mujoco>
