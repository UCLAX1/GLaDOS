<!-- perhaps look into here for implementing this pythonically: -->
<!--  https://github.com/google-deepmind/dm_control/blob/main/dm_control/mjcf/README.md -->
<mujoco>
  <!-- <option integrator="RK4"/> -->
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>


  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="2 2" texuniform="true" reflectance=".2"/>

  </asset>
  <worldbody>
    <!-- <light pos=".3 -.3 .8" mode="trackcom" diffuse="1 1 1" specular=".3 .3 .3"/> -->
    <light pos="0 0 1"/>
    <geom name="floor" type="plane" size="3 3 .01" pos="-0.025 -0.295  0" material="grid"/>

    

    <body name="base" pos="0 0 0.5">
      <geom name="base_plate" type="cylinder" pos="0 0 0.0" size="0.1 0.01" rgba="1 1 1 0.5"/>

      <body name="group_a" euler="0 0 270">

        <body name="servo_group_a" pos="0 0.1 0">
          <!-- <inertial pos="0.0 0.06 0" mass="0.02" diaginertia="1e-4 1e-4 1e-4"/> -->
          <joint name="servo_group_hinge_a" type="hinge" axis="1 0 0" damping="0.001" frictionloss="0.00025"/>
          <geom name="servo_geom_a" type="cylinder" euler="0 90 0" pos="0 0 0" size="0.02 0.02" contype="0" conaffinity="0"/>

          <body name="servo_arm_and_rod_a" pos="0 0 0">
            <geom name="servo_arm_a" type="capsule" fromto="0 0 0 0 0.08 0" size="0.01" contype="0" conaffinity="0"/>

            <body name="rod_a" pos="0 0.08 0">
              <joint name="rod_hinge_a" type="hinge" axis="1 0 0" damping="0.001" frictionloss="0.00025"/>
              <geom name="rod_geom_a" type="capsule" fromto="0 0 0 0 0.16 0" size="0.005"/>
              <site name="rod_geom_tip_site_a" pos="0 0.16 0"/>

            </body>
          </body>
        </body>
      </body>

      <body name="group_b" euler="0 0 30">

        <body name="servo_group_b" pos="0 0.1 0">
          <!-- <inertial pos="0.0 0.06 0" mass="0.02" diaginertia="1e-4 1e-4 1e-4"/> -->
          <joint name="servo_group_hinge_b" type="hinge" axis="1 0 0" damping="0.001" frictionloss="0.00025"/>
          <geom name="servo_geom_b" type="cylinder" euler="0 90 0" pos="0 0 0" size="0.02 0.02" contype="0" conaffinity="0"/>

          <body name="servo_arm_and_rod_b" pos="0 0 0">
            <geom name="servo_arm_b" type="capsule" fromto="0 0 0 0 0.08 0" size="0.01" contype="0" conaffinity="0"/>

            <body name="rod_b" pos="0 0.08 0">
              <joint name="rod_hinge_b" type="hinge" axis="1 0 0" damping="0.001" frictionloss="0.00025"/>
              <geom name="rod_geom_b" type="capsule" fromto="0 0 0 0 0.16 0" size="0.005"/>
              <site name="rod_geom_tip_site_b" pos="0 0.16 0"/>

            </body>
          </body>
        </body>
      </body>

      <body name="group_c" euler="0 0 150">

        <body name="servo_group_c" pos="0 0.1 0">
          <!-- <inertial pos="0.0 0.06 0" mass="0.02" diaginertia="1e-4 1e-4 1e-4"/> -->
          <joint name="servo_group_hinge_c" type="hinge" axis="1 0 0" damping="0.001" frictionloss="0.00025"/>
          <geom name="servo_geom_c" type="cylinder" euler="0 90 0" pos="0 0 0" size="0.02 0.02" contype="0" conaffinity="0"/>

          <body name="servo_arm_and_rod_c" pos="0 0 0">
            <geom name="servo_arm_c" type="capsule" fromto="0 0 0 0 0.08 0" size="0.01" contype="0" conaffinity="0"/>

            <body name="rod_c" pos="0 0.08 0">
              <joint name="rod_hinge_c" type="hinge" axis="1 0 0" damping="0.001" frictionloss="0.00025"/>
              <geom name="rod_geom_c" type="capsule" fromto="0 0 0 0 0.16 0" size="0.005"/>
              <site name="rod_geom_tip_site_c" pos="0 0.16 0"/>

            </body>
          </body>
        </body>
      </body>

      <!-- <body link_pair_a pos= -->

      <body name="rod_and_ball" pos="0 0 0.01">
        <geom name="middle_rod" type="cylinder" fromto="0 0 0 0 0 0.12" size="0.007"/>

        <body name="ball_and_center_site" pos="0 0 0.12">
          <geom name="ball" type="sphere" pos="0 0 0" size="0.02"/>
          <site name="ball_center_site" pos="0 0 0"/>

        </body>
      </body>


    </body>

    <body name="platform_and_sites" pos="0 0 0.665">
      <freejoint/>
      <geom name="platform" type="cylinder" pos="0 0 0" size="0.12 0.004"/>
      <!-- <joint type="ball" pos="0 0 -0.025"/> -->
      <site name="platform_center_site" pos="0 0 -0.004"/>

      <body name="platform_site_body_a" pos="0 0 0" euler="0 0 270">
        <site name="platform_site_a" pos="0 0.12 0"/>

      </body>

      <body name="platform_site_body_b" pos="0 0 0" euler="0 0 30">
        <site name="platform_site_b" pos="0 0.12 0"/>

      </body>

      <body name="platform_site_body_c" pos="0 0 0" euler="0 0 150">
        <site name="platform_site_c" pos="0 0.12 0"/>

      </body>
    </body>

    <!-- <geom name="debug_rod" type="cylinder" pos="0 0 0" size="0.01 0.01" rgba="1 0 0 1"/> -->

    <!-- <geom name="rod_0" type="cylinder" pos="0.1 0.1 0.2" size="0.005 0.2" euler="30 -30 0"/> -->

  </worldbody>

  <tendon>
    <spatial name="platform_ball_link" limited="true" range="0 0.021" width="0.003">
      <site site="platform_center_site"/>
      <site site="ball_center_site"/>
    </spatial>

  </tendon>

  <actuator>
    <position name="servo_a" joint="servo_group_hinge_a" kp="80" dampratio="1" ctrlrange="-1.57 1.57"/>
    <position name="servo_b" joint="servo_group_hinge_b" kp="80" dampratio="1" ctrlrange="-1.57 1.57"/>
    <position name="servo_c" joint="servo_group_hinge_c" kp="80" dampratio="1" ctrlrange="-1.57 1.57"/>

    <general name="theta_slider" joint="servo_group_hinge_a" gainprm="0" ctrllimited="true" ctrlrange="-180 180"/>
    <general name="phi_slider" joint="servo_group_hinge_a" gainprm="0" ctrllimited="true" ctrlrange="0 30"/>

  </actuator>

  <contact>
    <exclude body1="group_a" body2="platform_and_sites"/>
    <exclude body1="group_b" body2="platform_and_sites"/>
    <exclude body1="group_c" body2="platform_and_sites"/>

  </contact>

  <equality>
    <connect site1="rod_geom_tip_site_a" site2="platform_site_a"/>
    <connect site1="rod_geom_tip_site_b" site2="platform_site_b"/>
    <connect site1="rod_geom_tip_site_c" site2="platform_site_c"/>

  </equality>
</mujoco>
